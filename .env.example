# ============================================
# DTS Platform - 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值

# ── 数据库 (SQLite / PostgreSQL) ──
# SQLite (开发默认): sqlite://data/dts.db?mode=rwc
# PostgreSQL (生产):    postgres://user:pass@host:5432/dts
DATABASE_URL=sqlite://data/dts.db?mode=rwc

# ── 存储后端选择 ──
# 可选值: sqlite (默认) | postgres
DATABASE_BACKEND=sqlite

# ── sa-token-rust 会话认证 ──
AUTH_TOKEN_TIMEOUT_SECS=86400
# 单个控制面进程用 memory；多个实例共享会话需 redis 并启用 auth-redis feature。
AUTH_STORAGE=memory
# Redis 模式填写已有实例的连接地址；当前电脑无需安装或启动 Redis。
# AUTH_REDIS_URL=
# 仅在空数据库首次初始化时使用，至少 12 字节；后续启动不会重设现有密码。
BOOTSTRAP_ADMIN_PASSWORD=

# ── 服务器 ──
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DATA_DIR=./data
RUST_LOG=info,dts_server=debug

# ── 调度器集成 (jiascheduler, 可选) ──
JIA_ENABLED=false
JIA_BASE_URL=http://localhost:9090
JIA_USERNAME=admin
JIA_PASSWORD=admin
JIA_CALLBACK_BASE_URL=http://localhost:8080
# 单个 Linux worker 的真实 instance_id；worker 必须具有 bash/curl，且能访问上述管理 API。
JIA_INSTANCE_ID=
# 至少 32 字节的调度授权签名密钥，独立于用户会话；共享密钥不发送给 worker。
JIA_SERVICE_TOKEN=change-me-in-production

# ── DeerFlow AI 集成 (可选) ──
DEERFLOW_ENABLED=false
DEERFLOW_BASE_URL=http://localhost:11434
DEERFLOW_API_KEY=

# ── SwanLake 查询引擎（一个端点绑定一个租户） ──
SWANLAKE_ENABLED=false
SWANLAKE_HOST=localhost
SWANLAKE_PORT=4214
SWANLAKE_TENANT_SLUG=default

# 32 字节随机密钥的 Base64；未设置时保存在 DATA_DIR/.credentials-key，需随数据库备份。
# DTS_CREDENTIAL_KEY=

# ── 统一告警自动评估与站内投递 worker ──
ALERT_AUTOMATION_ENABLED=false
ALERT_AUTOMATION_POLL_SECONDS=5
ALERT_AUTOMATION_LEASE_SECONDS=30
ALERT_AUTOMATION_MAX_ATTEMPTS=5
ALERT_AUTOMATION_RETRY_BASE_SECONDS=30
