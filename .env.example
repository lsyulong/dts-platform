# ============================================
# DTS Platform - 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值

# ── Supabase / PostgreSQL ──
# 从 Supabase Dashboard > Settings > Database > Connection string 获取
# 使用 Session mode 连接 (端口 5432) 或 Transaction mode (端口 6543)
DATABASE_URL=postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── JWT 认证 ──
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_EXPIRY_HOURS=24

# ── 服务器 ──
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info,dts_server=debug

# ── 前端 (Vercel 部署时设置) ──
# VITE_API_BASE_URL=https://dts-api.fly.dev/api/v1

# ── Supabase (可选，用于 Supabase Auth SDK) ──
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_ANON_KEY=your-anon-key
